# ===========================================
# Kan-B AI - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ===========================================

# -------------------------------------------
# DATABASE (SQLite - Already configured)
# -------------------------------------------
DATABASE_URL="file:./db/custom.db"

# -------------------------------------------
# AUTHENTICATION (Required)
# -------------------------------------------
# Generate a secret: openssl rand -base64 32
# Or use any random string (min 32 characters)
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Application URL (optional for development)
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# AI PROVIDERS (Configure at least one)
# -------------------------------------------
# Choose your preferred AI provider(s):
# - OpenAI: High quality, pay per use (has transcription)
# - Groq: Free tier available, fast inference (has transcription)
# - DeepSeek: Very affordable, great for task extraction (chat only)
# - Ollama: Run locally for free! (transcription + chat)
# - Whisper.cpp: Local transcription, completely free!

# Option 1: OpenAI (GPT-4o-mini + Whisper)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Option 2: Groq (Llama 3.3 + Whisper - Free tier!)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=""

# Option 3: DeepSeek (Great for task extraction, no transcription)
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# Option 4: Ollama (Local - Free!)
# Install Ollama: https://ollama.ai
# Run: ollama pull llama3.2
OLLAMA_ENABLED=""
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_CHAT_MODEL="llama3.2"
OLLAMA_WHISPER_MODEL="whisper"

# Option 5: Whisper.cpp (Local transcription - Free!)
# Install: https://github.com/ggerganov/whisper.cpp
# Or on macOS: brew install whisper-cpp
# Download models: https://huggingface.co/ggerganov/whisper.cpp
WHISPER_CPP_ENABLED=""
WHISPER_CPP_BINARY="/opt/homebrew/opt/whisper-cpp/bin/whisper-cli"
WHISPER_MODEL_ES="/Users/your-user/.whisper-models/ggml-base.bin"
WHISPER_MODEL_EN="/Users/your-user/.whisper-models/ggml-base.en.bin"

# -------------------------------------------
# RECOMMENDED COMBINATIONS
# -------------------------------------------
#
# For local/free usage:
#   - Transcription: Whisper.cpp or Ollama
#   - Chat: Ollama (llama3.2)
#
# For cloud usage (with budget):
#   - Transcription: Groq (free tier)
#   - Chat: DeepSeek (very cheap)
#
# For best quality:
#   - Transcription: OpenAI Whisper
#   - Chat: OpenAI GPT-4o-mini
#
# -------------------------------------------
# HOW TO GET API KEYS
# -------------------------------------------
# 
# OpenAI:
#   1. Go to https://platform.openai.com/signup
#   2. Create an account
#   3. Go to API Keys section
#   4. Create a new secret key
#   5. Paste it above
#
# Groq (Recommended for free tier):
#   1. Go to https://console.groq.com
#   2. Sign up / Log in
#   3. Go to API Keys
#   4. Create a new key
#   5. Paste it above
#
# DeepSeek:
#   1. Go to https://platform.deepseek.com
#   2. Create an account
#   3. Go to API Keys
#   4. Create a new key
#   5. Paste it above
#   Note: DeepSeek doesn't support audio transcription
#
# Ollama (Local - No API key needed!):
#   1. Install Ollama: https://ollama.ai
#   2. Run: ollama pull llama3.2
#   3. Set OLLAMA_ENABLED="true"
#
# Whisper.cpp (Local - No API key needed!):
#   1. Install: brew install whisper-cpp (macOS)
#      Or build from source: https://github.com/ggerganov/whisper.cpp
#   2. Download models from: https://huggingface.co/ggerganov/whisper.cpp
#      Example: ggml-base.bin (Spanish), ggml-base.en.bin (English)
#   3. Set WHISPER_CPP_ENABLED="true"
#   4. Configure paths to binary and models
# 
# Note: If multiple keys are provided, priority is:
# OpenAI > Groq > DeepSeek > Ollama
# For transcription: OpenAI > Groq > Whisper.cpp > Ollama
# -------------------------------------------
